<!-- Arcane-Edit-Start -->
<ui1:EscapeMenu xmlns="https://spacestation14.io"
                xmlns:ui1="clr-namespace:Content.Client.Options.UI"
                Title="{Loc 'ui-escape-title'}"
                Resizable="False">
    <Control>
        <Control Name="BrowserHost" HorizontalExpand="True" VerticalExpand="True" />
        <Label Name="LoadingLabel" Text="{Loc 'ui-webui-loading'}" HorizontalAlignment="Center" VerticalAlignment="Center" />
        <BoxContainer Name="FallbackPanel" Orientation="Vertical" Visible="False" Margin="8">
            <Label Name="FallbackStatus" Text="{Loc 'ui-webui-fallback'}" />
            <Button Name="RetryBrowserButton" Text="{Loc 'ui-webui-retry'}" CanKeyboardFocus="True" />
            <ScrollContainer VerticalExpand="True" HScrollEnabled="False">
                <BoxContainer Name="FallbackActions" Orientation="Vertical" />
            </ScrollContainer>
        </BoxContainer>
    </Control>
</ui1:EscapeMenu>
<!-- Arcane-Edit-End -->
